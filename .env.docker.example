# ============================================================
# 请假管理系统 - Docker Compose 环境变量模板
# ------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env
#   2. 修改下面的密码（生产环境务必改掉默认值）
#   3. docker compose up -d --build
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_please
MYSQL_DATABASE=leave_system
# 宿主机映射端口（本机 3306 被占用时改成 3307）
MYSQL_PORT=3306

# ---- 后端 ----
# 宿主机映射端口
BACKEND_PORT=8080

# ---- 前端（可选）----
# 前端请求的后端地址，部署到公网时改成后端域名，例如：
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_BASE_URL=
