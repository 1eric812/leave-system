# ============================================================
# 请假管理系统 - 环境变量模板
# ------------------------------------------------------------
# 使用方法：
#   1. 复制本文件并重命名为 .env
#   2. 填入你自己的真实配置（数据库账号密码等）
#   3. .env 已被 .gitignore 忽略，不会提交到 GitHub
#
# 说明：Spring Boot 默认从系统环境变量读取。你也可以直接在
#       backend/src/main/resources/application.yml 里修改。
#       不设置时，后端会使用 application.yml 中的本地默认值（root/root）。
# ============================================================

# ---- 数据库配置（MySQL）----
# 数据库连接地址
DB_URL=jdbc:mysql://localhost:3306/leave_system?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false

# 数据库用户名
DB_USERNAME=root

# 数据库密码（请改为你自己的密码）
DB_PASSWORD=your_password_here

# ---- 后端服务 ----
# 后端启动端口
SERVER_PORT=8080
